# ==============================================================================
# ConduitAI — Environment Configuration Template
# Copy this file to `.env` and populate your API credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Meta Model API ($150 Hackathon Credit — https://dev.meta.ai)
#    Unified endpoint for Muse Spark, Muse Wonder, SAM 3.1, Muse Image & Voice
# ------------------------------------------------------------------------------
META_MODEL_API_KEY=your_meta_model_api_key_here
META_API_BASE_URL=https://api.meta.ai/v1

MUSE_SPARK_MODEL=muse-spark
MUSE_WONDER_MODEL=muse-wonder
SAM_3_1_MODEL=sam-3.1
MUSE_IMAGE_MODEL=muse-image
MUSE_VOICE_TRANSCRIBE_MODEL=muse-voice-transcribe
MUSE_CODE_MODEL=muse-code

# ------------------------------------------------------------------------------
# 2. Baseten Open-Weights Inference ($100 Credit + 2M TPM)
#    IMPORTANT: Hackathon override uses `meta-models/muse-spark-open-1026`
# ------------------------------------------------------------------------------
BASETEN_API_KEY=your_baseten_api_key_here
BASETEN_API_BASE_URL=https://inference.baseten.co/v1
BASETEN_MODEL=meta-models/muse-spark-open-1026

# ------------------------------------------------------------------------------
# 3. Modal Serverless GPU & Verifiable Digital Twin Sandboxes ($100 Credit)
#    Powers both:
#    (a) Layer-1/2 Socket Replay Digital Twin (`modal_cutover_twin.py`)
#    (b) Optional Air-Gapped On-Prem Mode via `Muse Glimmer` (30B Apache 2.0)
# ------------------------------------------------------------------------------
MODAL_PROFILE=lopesrohan1988
MODAL_SANDBOX_TIMEOUT=60
AIR_GAPPED_OPEN_WEIGHTS_MODE=false
MUSE_GLIMMER_MODEL=meta-models/Muse-Glimmer-30B
MUSE_GLIMMER_ENDPOINT_URL=
# Optional for headless CI/deployment (uses local `modal token set` profile by default):
# MODAL_TOKEN_ID=
# MODAL_TOKEN_SECRET=

# ------------------------------------------------------------------------------
# 4. ConduitAI Application & Workbench Settings
# ------------------------------------------------------------------------------
# Enables SHA-256 content-hash fallback traces if an upstream API rate-limits during judging
DEMO_CACHE_FALLBACK=true

# Frontend -> FastAPI Backend URL (SSE Streaming & REST API)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Backend Runtime & Pluggable Catalog Paths (relative to repo root or absolute)
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DATA_DIR=../data
HARDWARE_CATALOG_PATH=../data/catalogs/hardware_catalog.json
OUI_VENDORS_PATH=../data/catalogs/oui_vendors.json
IEC62443_CONTROLS_PATH=../data/catalogs/iec62443_controls.json
BENCHMARK_GROUND_TRUTH_PATH=../data/evals/benchmark_ground_truth.json
