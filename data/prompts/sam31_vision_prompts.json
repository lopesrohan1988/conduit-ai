{
  "prompt_pack_metadata": {
    "pack_id": "CONDUITAI_SAM31_DUAL_VISION_V1",
    "target_model": "meta/sam-3.1",
    "companion_vlm": "meta/muse-spark",
    "schema_version": "1.0.0",
    "last_updated": "2026-10-25",
    "description": "Dual-mode text-prompted segmentation configurations, geometric sizing heuristics, UI overlay palettes, few-shot examples, and strict JSON output schemas for Meta SAM 3.1 in ConduitAI."
  },
  "mode_1_network_diagram": {
    "mode_id": "DIAGRAM_AND_WHITEBOARD_PARSER",
    "purpose": "Segments security zone boundaries, Purdue swimlanes, industrial/IT device icons, and cross-zone conduit lines from legacy PDF/PNG diagrams or smartphone whiteboard sketches.",
    "inference_parameters": {
      "box_confidence_threshold": 0.32,
      "mask_iou_nms_threshold": 0.55,
      "crop_padding_px_for_ocr": 14,
      "return_polygon_masks": true
    },
    "sam31_text_prompts": [
      {
        "prompt_text": "security zone boundary box or dashed network region",
        "semantic_class": "ZONE_CONTAINER",
        "hud_color_hex": "#38BDF8"
      },
      {
        "prompt_text": "Purdue level horizontal swimlane banner",
        "semantic_class": "PURDUE_SWIMLANE",
        "hud_color_hex": "#818CF8"
      },
      {
        "prompt_text": "firewall icon or brick wall symbol",
        "semantic_class": "FIREWALL_BOUNDARY_NODE",
        "hud_color_hex": "#F97316"
      },
      {
        "prompt_text": "PLC controller or industrial automation module icon",
        "semantic_class": "OT_CONTROLLER_ICON",
        "hud_color_hex": "#10B981"
      },
      {
        "prompt_text": "server tower or database historian cylinder icon",
        "semantic_class": "SERVER_OR_HISTORIAN_ICON",
        "hud_color_hex": "#A855F7"
      },
      {
        "prompt_text": "network switch box with arrows",
        "semantic_class": "NETWORK_SWITCH_ICON",
        "hud_color_hex": "#14B8A6"
      },
      {
        "prompt_text": "security camera or CCTV dome icon",
        "semantic_class": "CCTV_OR_IOT_ICON",
        "hud_color_hex": "#FACC15"
      },
      {
        "prompt_text": "workstation monitor or operator HMI screen icon",
        "semantic_class": "WORKSTATION_HMI_ICON",
        "hud_color_hex": "#60A5FA"
      },
      {
        "prompt_text": "connecting network line or directional conduit arrow",
        "semantic_class": "NETWORK_CONDUIT_EDGE",
        "hud_color_hex": "#94A3B8"
      },
      {
        "prompt_text": "IP address subnet or VLAN text annotation label",
        "semantic_class": "IP_VLAN_ANNOTATION",
        "hud_color_hex": "#E2E8F0"
      }
    ],
    "muse_spark_crop_extraction_prompt": "Given the full network diagram and the SAM 3.1 segmented bounding boxes (`ZONE_CONTAINER`, `OT_CONTROLLER_ICON`, `SERVER_OR_HISTORIAN_ICON`, `FIREWALL_BOUNDARY_NODE`), extract every labeled asset's hostname, IP address, VLAN tag, assigned zone, and intended interconnections into the `DiagramSegmentationResult` JSON schema. Flag any handwritten whiteboard notes or unclear legacy connections.",
    "output_json_schema": {
      "type": "object",
      "required": ["source_image_type", "detected_zones", "detected_diagram_nodes", "detected_diagram_conduits"],
      "properties": {
        "source_image_type": {
          "type": "string",
          "enum": ["CAD_VISIO_DIAGRAM", "HANDDRAWN_WHITEBOARD_SKETCH", "SCANNED_PAPER_BLUEPRINT", "AUTOCAD_DARK_PID"]
        },
        "detected_zones": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["zone_box_id", "label", "inferred_purdue_level", "bbox_xyxy"],
            "properties": {
              "zone_box_id": { "type": "string" },
              "label": { "type": "string" },
              "inferred_purdue_level": { "type": "string" },
              "bbox_xyxy": { "type": "array", "items": { "type": "number" }, "minItems": 4, "maxItems": 4 }
            }
          }
        },
        "detected_diagram_nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["node_id", "semantic_class", "extracted_label", "extracted_ip", "parent_zone_box_id", "confidence", "bbox_xyxy"],
            "properties": {
              "node_id": { "type": "string" },
              "semantic_class": { "type": "string" },
              "extracted_label": { "type": "string" },
              "extracted_ip": { "type": ["string", "null"] },
              "parent_zone_box_id": { "type": ["string", "null"] },
              "confidence": { "type": "number" },
              "bbox_xyxy": { "type": "array", "items": { "type": "number" }, "minItems": 4, "maxItems": 4 }
            }
          }
        },
        "detected_diagram_conduits": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["from_node_id", "to_node_id", "protocol_annotation"],
            "properties": {
              "from_node_id": { "type": "string" },
              "to_node_id": { "type": "string" },
              "protocol_annotation": { "type": ["string", "null"] }
            }
          }
        }
      }
    },
    "few_shot_example_output": {
